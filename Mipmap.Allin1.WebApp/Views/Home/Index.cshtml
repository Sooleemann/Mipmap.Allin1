                <span class="fas fa-angle-double-right text-light"></span> 
            </button> *@
            <a class="navbar-brand p-0" href="https://www.mipmap-technologies.com" target="_blank">

                <img src="~/images/logo_light.png" alt="Logo" class="img-fluid" style="max-height:32px;" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-form form-inline ms-lg-4">
                <div class="search-box" id="searchBox">
                </div>
            </div>
            <div class="collapse navbar-collapse" id="navbarNavDropdown">
                <ul class="navbar-nav mx-auto">

                    <li class="nav-item  pe-lg-1">
                        <button type="button" id="btnHome" data-widget="home" data-button="toolbar" class="btn btn-outline-tanap " data-bs-toggle="tooltip" title="Anasayfa">
                            <i class="fas fa-home text-light"></i>
                            <span class="d-inline-block d-lg-none text-light">Home</span>
                        </button>
                    </li>

                    <li class="nav-item pe-lg-1">

                        <button type="button" id="btnMeasureLine" data-widget="distance" data-button="toolbar" class="btn btn-outline-tanap" data-bs-toggle="tooltip" title="Measure Length">
                            <i class="fas fa-ruler text-light"></i>
                            <span class="d-inline-block d-lg-none text-light">Measure Length</span>
                        </button>
                    </li>
                    <li class="nav-item  pe-lg-1">
                        <button type="button" id="btnMeasurePoly" data-widget="area" data-button="toolbar" class="btn btn-outline-tanap " data-bs-toggle="tooltip" title="Measure Area">
                            <i class="fas fa-draw-polygon text-light"></i>
                            <span class="d-inline-block d-lg-none text-light">Measure Area</span>
                        </button>
                    </li>
                    <li class="nav-item pe-lg-1">
                        <button type="button" id="btnMeasureProfile" data-widget="profile" data-button="toolbar" class="btn btn-outline-tanap " data-bs-toggle="tooltip" title="Elevation Profile">
                            <i class="esri-icon-elevation-profile text-light"></i>
                            <span class="d-inline-block d-lg-none text-light">Elevation Profile</span>
                        </button>
                    </li>

                    <li class="nav-item  pe-lg-1">
                        <button type="button" id="btnDaylight" data-widget="daylight" data-button="toolbar" class="btn btn-outline-tanap " data-bs-toggle="tooltip" title="Daylight">
                            <i class="fas fa-sun text-light"></i>
                            <span class="d-inline-block d-lg-none text-light">Daylight</span>
                        </button>
                    </li>
                    <li class="nav-item  pe-lg-1">
                        <button type="button" id="btnWeather" data-widget="weather" data-button="toolbar" class="btn btn-outline-tanap " data-bs-toggle="tooltip" title="Weather">
                            <i class="fas fa-cloud-moon-rain text-light"></i>
                            <span class="d-inline-block d-lg-none text-light">Weather</span>
                        </button>
                    </li>
                    
                    <li class="nav-item  pe-lg-1">
                        <button type="button" id="btnRoute" data-widget="route" data-button="toolbar" class="btn btn-outline-tanap " data-bs-toggle="tooltip" title="Route">
                            <i class="fas fa-route text-light"></i>
                            <span class="d-inline-block d-lg-none text-light">Route</span>
                        </button>
                    </li>

                    <li class="nav-item  pe-lg-1">
                        <button type="button" id="btnBaseMaps" data-widget="basemaps" data-button="toolbar" class="btn btn-outline-tanap " data-bs-toggle="tooltip" title="Basemaps">
                            <i class="fab fa-windows text-light"></i>
                            <span class="d-inline-block d-lg-none text-light">Basemaps</span>
                        </button>
                    </li>
                    <li class="nav-item  pe-lg-1">
                        <button type="button" id="btnLegend" data-widget="legend" data-button="toolbar" class="btn btn-outline-tanap" data-bs-toggle="tooltip" title="Legend">
                            <i class="fas fa-list text-light"></i>
                            <span class="d-inline-block d-lg-none text-light">Legend</span>
                        </button>
                    </li>
                </ul>
                <div class="d-flex">
                </div>
            </div>
        </div>
    </nav>


